@page "/register"
@inject HttpClient Http

<h3>Sensor Registration & Configuration</h3>

<div class="card">
    <div class="card-body">
        <form @onsubmit="SubmitForm">
            <div class="mb-3">
                <label class="form-label">MAC Address / Unique ID</label>
                <input type="text" class="form-control" @bind="registration.MacAddress" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Deployment Location</label>
                <input type="text" class="form-control" @bind="registration.Location" placeholder="e.g., Facility A -> Zone 1 -> Sub-Zone B" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Sensor Category</label>
                <select class="form-select" @bind="registration.Category">
                    <option value="Environmental">Environmental</option>
                    <option value="Power Consumption">Power Consumption</option>
                    <option value="Actuator">Actuator</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Configuration File / Log Attachment</label>
                <InputFile type="file" class="form-control" @onchange="OnFileSelected" />
                <small class="text-muted">@fileName</small>
            </div>
            <button type="submit" class="btn btn-success">Register Sensor</button>
        </form>
        <p class="mt-3 text-success fw-bold">@message</p>
    </div>
</div>

@code {
    private SensorRegistration registration = new();
    private IBrowserFile? selectedFile;
    private string fileName = "No file chosen";
    private string message = "";

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        fileName = selectedFile.Name;
    }

    private async Task SubmitForm()
    {
        // 1. Register Sensor
        var response = await Http.PostAsJsonAsync("/api/sensors/register", registration);
        if (response.IsSuccessStatusCode)
        {
            message = "Sensor registered successfully! ";
            
            // 2. Upload File if exists
            if (selectedFile != null)
            {
                var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10)); // 10MB limit
                content.Add(fileContent, "file", selectedFile.Name);
                
                var uploadResponse = await Http.PostAsync($"/api/sensors/{registration.MacAddress}/upload", content);
                if (uploadResponse.IsSuccessStatusCode)
                {
                    message += "File uploaded successfully.";
                }
                else
                {
                    message += "File upload failed.";
                }
            }
        }
        else
        {
            message = "Registration failed.";
        }
    }

    public class SensorRegistration
    {
        public string MacAddress { get; set; } = "";
        public string Location { get; set; } = "";
        public string Category { get; set; } = "";
    }
}